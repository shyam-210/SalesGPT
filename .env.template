# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_service_role_key_here
DATABASE_URL=your_supabase_postgres_connection_string_here

# ============================================
# AI API Configuration (for models)
# ============================================
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================
# Application Configuration
# ============================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# Session Configuration
# ============================================
SESSION_TIMEOUT_MINUTES=30
LEAD_RETENTION_DAYS=30

# ============================================
# AI Model Configuration
# ============================================
# Fast Track (Chat Agent) — flagship conversational model
CHAT_MODEL=llama-3.3-70b-versatile

# Slow Track (Judge Agent) — high-reasoning model for BANT scoring
JUDGE_MODEL=openai/gpt-oss-120b

# Email Drafting — fast model for email generation
EMAIL_MODEL=llama-3.1-8b-instant

# Extractor — fast model for contact-info extraction
EXTRACTOR_MODEL=llama-3.1-8b-instant

# Embedding Model (Local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================
# RAG Configuration
# ============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# ============================================
# BANT Scoring Configuration
# ============================================
MIN_QUALIFIED_SCORE=70
SCORE_DECAY_HOURS=24
